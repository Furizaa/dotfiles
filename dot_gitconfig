[core]
	autocrlf = input
	editor = vim
  pager = delta

[init]
	defaultBranch = main

[pull]
	rebase = true

[rebase]
	autoStash = true

[rerere]
	enabled = true
	autoUpdate = true

[merge]
	conflictStyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[fetch]
	prune = true
	pruneTags = false

[branch]
	sort = -committerdate

[tag]
	sort = -version:refname

[status]
	short = true

[log]
	date = iso

[push]
	autoSetupRemote = true
  followTags = true

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  dark = true

[include]
  path = ~/.config/delta/themes.gitconfig
